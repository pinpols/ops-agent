# 阶段 1 用 Anthropic(默认)。去 console.anthropic.com 拿 key。
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-6
# dev 默认允许自由只读 SQL;prod 默认禁止自由 SQL,要求使用 query_pg_template。
# OPS_PROFILE=prod
# OPS_SQL_ALLOW_FREE=false
# 想换 Ollama 本地(免费):跑 `ollama serve` + `ollama pull qwen2.5:7b`,
# 然后用 openai 兼容端点 base_url=http://localhost:11434/v1,key 随便填。

# 目标系统。默认会自动探测 ../file-batch-system;也可显式指定。
# OPS_TARGET_ROOT=../file-batch-system
# 默认日志目录:若发现 OPS_TARGET_ROOT/logs 则使用它,否则使用 ops-agent/data。
# OPS_LOG_DIR=../file-batch-system/logs

# 本地 agent trace / 诊断包输出
# OPS_TRACE_DIR=.ops-agent/traces
# OPS_BUNDLE_DIR=.ops-agent/bundles
# OPS_REDACT_ARTIFACTS=true

# 阶段 3:query_pg 连只读 SQL 的库(不配则 query_pg 跳过)
# OPS_PG_DSN=postgresql://batch_user:pass@localhost:15432/batch_platform

# ②执行工具(restart_service):默认 dry-run;真执行要两个都设
# OPS_ALLOW_EXEC=true
# OPS_RESTART_CMD=bash ../file-batch-system/scripts/local/restart.sh {service}
# OPS_EXEC_ALLOWLIST=bash
# OPS_APPROVAL_LOG=.ops-agent/approvals.jsonl
# 注意:命令会按 argv 执行且必须命中 OPS_EXEC_ALLOWLIST;不要依赖管道/重定向。

# ③可选 Langfuse trace(配了才启用,否则 obs no-op):见 docs/observability-setup.md
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_HOST=https://cloud.langfuse.com
