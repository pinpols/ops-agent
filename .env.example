# 阶段 1 用 Anthropic(默认)。去 console.anthropic.com 拿 key。
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-6
# dev 默认允许自由只读 SQL;prod 默认禁止自由 SQL,要求使用 query_pg_template。
# OPS_PROFILE=prod
# OPS_SQL_ALLOW_FREE=false
# 想换 Ollama 本地(免费):跑 `ollama serve` + `ollama pull qwen2.5:7b`,
# 然后用 openai 兼容端点 base_url=http://localhost:11434/v1,key 随便填。

# 目标系统。默认会自动探测 ../file-batch-system;也可显式指定。
# OPS_TARGET_ROOT=../file-batch-system
# 默认日志目录:若发现 OPS_TARGET_ROOT/logs 则使用它,否则使用 ops-agent/data。
# OPS_LOG_DIR=../file-batch-system/logs

# 本地 agent trace / 诊断包输出
# OPS_TRACE_DIR=.ops-agent/traces
# OPS_BUNDLE_DIR=.ops-agent/bundles
# OPS_REDACT_ARTIFACTS=true

# 阶段 3:query_pg 连只读 SQL 的库(不配则 query_pg 跳过)
# OPS_PG_DSN=postgresql://batch_user:pass@localhost:15432/batch_platform

# ②执行工具(restart_service):默认 dry-run;真执行要两个都设
# OPS_ALLOW_EXEC=true
# OPS_RESTART_CMD=bash ../file-batch-system/scripts/local/restart.sh {service}
# OPS_EXEC_ALLOWLIST=bash
# OPS_APPROVAL_LOG=.ops-agent/approvals.jsonl
# 注意:命令会按 argv 执行且必须命中 OPS_EXEC_ALLOWLIST;不要依赖管道/重定向。
# 生产 fail-closed:OPS_PROFILE=prod 下,OPS_ALLOW_EXEC=true 仍不够,必须再显式设
# OPS_PROD_ALLOW_EXEC=true 才会真执行(防 dev/CI 的 OPS_ALLOW_EXEC 泄漏继承到 prod)。
# OPS_PROD_ALLOW_EXEC=true

# ③可选 Langfuse trace(配了才启用,否则 obs no-op):见 docs/observability-setup.md
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# 走 agent-ctl 网关(路由/回退/成本/缓存 + 全量捕获);默认 false=原生直连
OPS_USE_GATEWAY=false
AGENT_CTL_CONFIG=../agent-ctl/agent-ctl.example.yaml

# ───────── T1 生产化(ops-agent serve / 多目标 / 预算 / 指标)─────────
# 触发服务 webhook 鉴权 token(POST /diagnose 必需;未配则 fail-closed 只放行 /healthz、/metrics)
# OPS_WEBHOOK_TOKEN=change-me-long-random
# 密钥可改走文件注入(docker/k8s secret):设 <NAME>_FILE 指向挂载的密钥文件
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
# OPS_PG_DSN_FILE=/run/secrets/pg_dsn
# OPS_WEBHOOK_TOKEN_FILE=/run/secrets/webhook_token

# 多目标注册表(不配则回退单目标 OPS_TARGET_ROOT/OPS_LOG_DIR/...);见 targets.toml.example
# OPS_TARGETS_FILE=targets.toml
# 单目标 Prometheus 地址(query_metrics 工具用);多目标时写进 targets.toml 的 metrics_url
# OPS_METRICS_URL=http://localhost:9090

# 单次 run 预算闸(防绕圈烧钱):墙钟秒 / 累计 token 上限
# OPS_MAX_RUN_SECONDS=120
# OPS_MAX_RUN_TOKENS=200000

# agent 自身指标:配了则把 Prometheus 计数原子写到该 textfile(serve 的 /metrics 也暴露进程内累计)
# OPS_METRICS_FILE=.ops-agent/metrics.prom
# 审计文件按大小滚动(超过即 .1 归档);生产应再投递到集中/不可篡改存储
# OPS_AUDIT_MAX_BYTES=10485760
