# 多目标注册表示例。复制为 targets.toml(OPS_TARGETS_FILE 可改路径)。
# 每个 target = 被诊断系统的连接信息;ops-agent --target <name> / webhook {"target": "<name>"} 选用。
# 未提供本文件时,回退到单目标 env(OPS_TARGET_ROOT / OPS_LOG_DIR / OPS_PG_DSN / OPS_METRICS_URL)。

[targets.file-batch-system]
root = "../file-batch-system"
log_dir = "../file-batch-system/logs"
# 生产务必用只读最小权限 DB 用户(doctor 会校验非 postgres/root/admin)
pg_dsn = "postgresql://ops_ro@localhost:5432/batch"
metrics_url = "http://localhost:9090"

# [targets.payments]
# root = "/srv/payments"
# log_dir = "/var/log/payments"
# metrics_url = "http://prometheus.internal:9090"
